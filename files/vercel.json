{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["sao-paulo"],
  "env": {
    "REACT_APP_SITE_NAME": "Dalumia"
  },
  "redirects": [
    {
      "source": "/servicos",
      "destination": "/#servicos",
      "permanent": false
    },
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": false
    },
    {
      "source": "/contato",
      "destination": "/#contato",
      "permanent": false
    }
  ]
}
